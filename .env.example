# Optional AI explanations. Keep keys private and never commit .env.
# Configure both keys for fallback. Set AI_PROVIDER_ORDER=gemini,groq to prefer Gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER_ORDER=groq,gemini
MAX_UPLOAD_MB=10

# Optional Sightengine video AI-generated/deepfake model scan (explicit user opt-in)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Optional Have I Been Pwned known-breach lookup (explicit user opt-in)
HIBP_API_KEY=
